{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techsmartfix-it",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
